# Src Uploads (QUAN TRỌNG: Ignore ảnh upload để tránh conflict production)
src/uploads/*
!src/uploads/.gitkeep
!src/uploads/.htaccess
!src/uploads/authors/.gitkeep
!src/uploads/avatars/.gitkeep
!src/uploads/blog/.gitkeep
!src/uploads/posts_content/.gitkeep
!src/uploads/templates/.gitkeep
!src/uploads/temp/.gitkeep

*.log

# Environment & Config Files
.env
.env.local
.env.staging
.env.production
config.php

# Cache & Temporary
cache/
temp/
*.tmp
*.swp
*.swo

# IDE & Editor
.vscode/
.idea/
*.sublime-*
.DS_Store

# OS
.DS_Store?
Thumbs.db
*.desktop

