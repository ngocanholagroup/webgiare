# Environment Configuration
APP_ENV=development
APP_DEBUG=true

# Database Configuration - Development
DB_HOST=db
DB_NAME=webgiare_dev
DB_USER=webgiare_user
DB_PASS=root
MYSQL_ROOT_PASSWORD=root
DB_PORT=3306

# MinIO Configuration
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=12345678

# Umami Analytics Configuration
UMAMI_DB=admin
UMAMI_USER=admin
UMAMI_PASSWORD=umami

# Application URL (tự động detect trong code)
# BASE_URL=https://webgiare.cloud
BASE_URL=http://localhost:8080

# Media Server Configuration
# Khi chạy ngoài Docker (Host machine): http://localhost:3001/upload
# Khi chạy trong Docker (Web container): http://webgiare_media:3000/upload (Được override trong docker-compose.yml)
MEDIA_SERVER_URL=http://localhost:3001/upload

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
ENCRYPTION_KEY=your-32-character-encryption-key-here

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_PATH=uploads/

# Cache
CACHE_DRIVER=file
CACHE_TTL=3600

# Email Configuration (nếu cần)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls

APP_SECRET=random-secret-53105710
