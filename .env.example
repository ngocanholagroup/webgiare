# Environment Configuration Template
# Copy this file to .env và chỉnh sửa cho môi trường của bạn

# ===========================================
# ENVIRONMENT SETUP
# ===========================================
APP_ENV=development
APP_DEBUG=false

# ===========================================
# DATABASE CONFIGURATION  
# ===========================================
# Development (local)
DB_HOST=localhost
DB_NAME=webgiare_db
DB_USER=webgiare_user
DB_PASS=SecurePassword123!@#
DB_PORT=3306

# Production (server)
# DB_HOST=your-production-db-host.com
# DB_NAME=your_production_db
# DB_USER=your_production_user  
# DB_PASS=your_production_password

# ===========================================
# APPLICATION URL
# ===========================================
# Development (local)
BASE_URL=http://localhost:8080

# Production  
# BASE_URL=https://your-domain.com

# ===========================================
# SECURITY KEYS
# ===========================================
# IMPORTANT: Change these keys in production!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
ENCRYPTION_KEY=your-32-character-encryption-key-here-min-32-chars

# ===========================================
# FILE UPLOAD CONFIGURATION
# ===========================================
MAX_UPLOAD_SIZE=10485760
UPLOAD_PATH=uploads/

# ===========================================
# CACHE CONFIGURATION
# ===========================================
CACHE_DRIVER=file
CACHE_TTL=3600

# ===========================================
# EMAIL CONFIGURATION (Optional)
# ===========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls

# ===========================================
# DOCKER CONFIGURATION (Optional)
# ===========================================
# MySQL Root Password (chỉ cho Docker environment)
MYSQL_ROOT_PASSWORD=RootPassword123!@#

# ===========================================
# DEPLOYMENT INSTRUCTIONS
# ===========================================
# 1. Copy file này sang .env:
#    cp .env.example .env
#
# 2. Chỉnh sửa các giá trị:
#    - APP_ENV: development | staging | production
#    - DB_HOST, DB_NAME, DB_USER, DB_PASS: Database info
#    - BASE_URL: URL của ứng dụng
#    - JWT_SECRET, ENCRYPTION_KEY: Security keys (CHANGE IN PRODUCTION!)
#
# 3. Các biến môi trường cần thiết lập:
#    - Development: Localhost, database local
#    - Staging: Staging server, staging database  
#    - Production: Live server, production database, real security keys
#
# 4. Lưu ý quan trọng:
#    - Không bao giờ commit file .env vào Git
#    - Luôn thay đổi security keys khi deploy production
#    - Kiểm tra kỹ database connection trước khi deploy
#    - Sử dụng passwords mạnh và unique
