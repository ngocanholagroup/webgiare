# Environment Configuration
APP_ENV=development
APP_DEBUG=true

# Database Configuration - Development
DB_HOST=db
DB_NAME=webgiare_dev
DB_USER=webgiare_user
DB_PASS=root
MYSQL_ROOT_PASSWORD=root
DB_PORT=3306

# Umami Analytics Configuration
UMAMI_DB=admin
UMAMI_USER=admin
UMAMI_PASSWORD=umami
UMAMI_CONSOLE_URL=https://umami.webgiare.cloud

# Application URL (tự động detect trong code)
BASE_URL=https://webgiare.cloud
# BASE_URL=http://localhost:8080

# Media Server Configuration
MEDIA_SERVER_URL=https://webgiare.cloud/upload

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
ENCRYPTION_KEY=your-32-character-encryption-key-here
APP_SECRET=random-secret-53105710

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_PATH=uploads/
