# Prevent PHP code execution in uploads directory
<FilesMatch "\.php$">
    Deny from all
</FilesMatch>

<FilesMatch "\.phtml$">
    Deny from all
</FilesMatch>

<FilesMatch "\.php3$">
    Deny from all
</FilesMatch>

<FilesMatch "\.php4$">
    Deny from all
</FilesMatch>

<FilesMatch "\.php5$">
    Deny from all
</FilesMatch>

<FilesMatch "\.php7$">
    Deny from all
</FilesMatch>

# Prevent .htaccess modification
<Files ~ "\.htaccess$">
    Deny from all
</Files>

# Disable directory listing
Options -Indexes

# Disable execution of scripts
AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .phps

# Additional security headers (if modrewrite is enabled)
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Prevent access to sensitive files
    RewriteRule "\.env$" - [F]
    RewriteRule "\.env\..*$" - [F]
    RewriteRule "\.git" - [F]
    RewriteRule "composer\.(json|lock)$" - [F]
</IfModule>
